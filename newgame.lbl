0010CFr 2               .proc loadDisplayStart
0010CFr 2  A9 01            LDA #$01
0010D1r 2  85 rr            STA stopScroll
0010D3r 2  A9 01            LDA #%00000001
0010D5r 2  8D rr rr         STA isLoadedFlags
0010D8r 2  20 rr rr         JSR setHorizontalMirror
0010DBr 2                   ; change prg bank
0010DBr 2  A9 01            LDA #%00000001
0010DDr 2  20 rr rr         JSR setPrgBank
0010E0r 2                   ; change chr bank
0010E0r 2  A9 04            LDA #%00000100
0010E2r 2  20 rr rr         JSR changeChrZerro
0010E5r 2                   ; load background
0010E5r 2  20 rr rr         JSR loadStartDisplayFirstBackground
0010E8r 2  A9 20            LDA #$20
0010EAr 2  85 rr            STA highBackground
0010ECr 2  A9 00            LDA #$00
0010EEr 2  85 rr            STA lowBackground
0010F0r 2  20 rr rr         JSR loadBackground
0010F3r 2               
