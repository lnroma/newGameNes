000D06r 2               .proc animationPalete
000D06r 2  AD 02 20         LDA $2002
000D09r 2  A9 3F            LDA #$3F
000D0Br 2  8D 06 20         STA $2006
000D0Er 2  A9 0B            LDA #$0B
000D10r 2  8D 06 20         STA $2006
000D13r 2               
000D13r 2  A5 rr            LDA animationCounter
000D15r 2  C9 00            CMP #$00
000D17r 2  F0 0E            BEQ frame1
000D19r 2  C9 02            CMP #$02
000D1Br 2  F0 0F            BEQ frame2
000D1Dr 2  C9 03            CMP #$03
000D1Fr 2  F0 10            BEQ frame3
000D21r 2  C9 04            CMP #$04
000D23r 2  F0 07            BEQ frame2
000D25r 2               
000D25r 2  D0 12            BNE return
000D27r 2               
000D27r 2               frame1:
000D27r 2  A9 0C            LDA #$0C
000D29r 2  4C rr rr         JMP toPort
000D2Cr 2               frame2:
000D2Cr 2  A9 1C            LDA #$1C
000D2Er 2  4C rr rr         JMP toPort
000D31r 2               frame3:
000D31r 2  A9 2C            LDA #$2C
000D33r 2  4C rr rr         JMP toPort
000D36r 2               toPort:
000D36r 2  8D 07 20         STA $2007
000D39r 2               return:
000D39r 2  60               RTS
000D3Ar 2               .endproc
000D3Ar 2               
000D3Ar 2               .proc animationCounterProc
000D3Ar 2  AD rr rr             LDA nmiCounter
000D3Dr 2  F0 02                BEQ incrementFrameCounter
000D3Fr 2  D0 02                BNE return
000D41r 2                   incrementFrameCounter:
000D41r 2  E6 rr                INC animationCounter
000D43r 2                   return:
000D43r 2  60                   RTS
000D44r 2               .endproc
000D44r 2               
000D44r 2               .proc resetAnimationCounter
000D44r 2  A5 rr            LDA animationCounter
000D46r 2  C9 06            CMP #06
000D48r 2  F0 02            BEQ reset
000D4Ar 2  D0 04            BNE return
000D4Cr 2               reset:
000D4Cr 2  A9 00            LDA #$00
000D4Er 2  85 rr            STA animationCounter
000D50r 2               return:
000D50r 2  60               RTS
000D51r 2               .endproc
