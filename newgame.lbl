000CDDr 2               .proc loadPaleteStageTwo
000CDDr 2                 LoadPalettes:
000CDDr 2  AD 02 20         LDA $2002
000CE0r 2  A9 3F            LDA #$3F
000CE2r 2  8D 06 20         STA $2006             ; говорим ppu что нам необходим адрес 3F00 здесь храниться палитра
000CE5r 2  A9 00            LDA #$00
000CE7r 2  8D 06 20         STA $2006             ; Сначала старший байт записываем 3F потом младший 00 при записи этот адрес будет автоматически увеличиваться
000CEAr 2               
000CEAr 2  A2 00            LDX #$00              ; X = 0
000CECr 2                 LoadPalettesLoop:
000CECr 2  BD rr rr         LDA palette_data_stage_2, x
000CEFr 2  8D 07 20         STA $2007             ; записываем в ppu по факту в адрес 3F00
000CF2r 2  E8               INX                   ; X = X + 1
000CF3r 2  E0 20            CPX #$20
000CF5r 2  D0 F5            BNE LoadPalettesLoop
000CF7r 2               
000CF7r 2  60               RTS
000CF8r 2               .endproc
