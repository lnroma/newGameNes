0010F6r 2  A9 28            LDA #$28
0010F8r 2  85 rr            STA highBackground
0010FAr 2  A9 00            LDA #$00
0010FCr 2  85 rr            STA lowBackground
0010FEr 2  20 rr rr         JSR loadBackground
