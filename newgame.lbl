000CFAr 2  C9 00            CMP #$00
000CFCr 2  F0 0E            BEQ frame1
000CFEr 2  C9 02            CMP #$02
000D00r 2  F0 0F            BEQ frame2
000D02r 2  C9 03            CMP #$03
000D04r 2  F0 10            BEQ frame3
000D06r 2  C9 04            CMP #$04
000D08r 2  F0 07            BEQ frame2
000D0Ar 2               
000D0Ar 2  D0 12            BNE return
000D0Cr 2               
000D0Cr 2               frame1:
000D0Cr 2  A9 0C            LDA #$0C
