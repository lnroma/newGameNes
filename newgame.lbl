000D72r 2  A2 00        	ldx #0
000D74r 2  8E 00 20     	stx $2000		; обнуляем память
000D77r 2  8E 01 20     	stx $2001		; выключаем рендер
000D7Ar 2  8E 10 40     	stx $4010	; отключаем DMC
000D7Dr 2  CA           	dex 				; X = $FF
000D7Er 2  9A           	txs					; Стэк равен = $FF
000D7Fr 2  2C 02 20     :	bit $2002
000D82r 2  10 FB        	bpl :-
000D84r 2               
000D84r 2  60           	RTS
000D85r 2               .endproc
