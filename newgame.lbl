0015C4r 1               .proc loadBanks
0015C4r 1  A2 08                LDX #$08            ; Start of Page to load Add 8 Hex per CHR .. CHR 3 = $10 or 16
0015C6r 1  A9 80                LDA #$80            ; Starting Address for $8000 0,1,2,3,4,5,6
0015C8r 1  A0 00                LDY #$00            ; Loop Counter
0015CAr 1                       LoadPPU2k:          ; load two sets 2x2k to make first 4k (BACKGROUND)
0015CAr 1  8D 00 80                 STA $8000       ; Bank Selection with Inversion
0015CDr 1  8E 01 80                 STX $8001       ; Selection of Bank
0015D0r 1  C8                       INY
0015D1r 1  E8                       INX             ; Increase X x 2 as 2k
0015D2r 1  E8                       INX
0015D3r 1  18                       CLC
0015D4r 1  69 01                    ADC #$01
0015D6r 1  C0 02                    CPY #$02        ; For loop
0015D8r 1  D0 F0                    BNE LoadPPU2k
0015DAr 1                       LoadPPU1k:              ; load 4 * 1k sets to make FORGROUND 4k
0015DAr 1  8D 00 80                 STA $8000           ; Bank Selection with Inversion
0015DDr 1  8E 01 80                 STX $8001           ; Selection of Bank
0015E0r 1  C8                       INY
0015E1r 1  E8                       INX                 ; Increase X * x as 1k
0015E2r 1  18                       CLC
0015E3r 1  69 01                    ADC #$01
0015E5r 1  C0 06                    CPY #$06        ; For loop
0015E7r 1  D0 F1                    BNE LoadPPU1k
0015E9r 1  60               RTS
0015EAr 1               .endproc
0015EAr 1               
0015EAr 1               .proc initMMC3
0015EAr 1  A2 00            LDX #$00
0015ECr 1  A9 00            LDA #$00
0015EEr 1  8D 00 E0         STA $E000       ; IRQ disable
0015F1r 1  8D 00 A0         STA $A000       ; mirroring 0 Vertical; 1 Horizontal
0015F4r 1                   :
0015F4r 1  8E 00 80         STX $8000       ; select register
0015F7r 1  BD rr rr         LDA mmc3Register, X
0015FAr 1  8D 01 80         STA $8001       ; initialize register
0015FDr 1  E8               INX
0015FEr 1  E0 08            CPX #8          ; Compare 8 to X
001600r 1  90 F2            BCC :-          ; Branch not Equal
001602r 1               
001602r 1                   ;PRG ROM Selections
001602r 1               
001602r 1  A0 02                LDY #02            ; Starting Banks Change This from 0 2 4 6 ETC to change Starting Color Startup $00
001604r 1  A9 06                LDA #6              ; $8000 Selection Bank = 6 (NOTE: Not HEX)
001606r 1  8D 00 80             STA $8000
001609r 1  8C 01 80             STY $8001           ; Select Bank LOW
00160Cr 1  A9 07                LDA #7              ; $A000 Selection Bank = 6 (NOTE: Not HEX)
00160Er 1  8D 00 80             STA $8000
001611r 1  C8                   INY
001612r 1  8C 01 80             STY $8001           ; Select Bank HIGH
001615r 1               
001615r 1  60                   rts
001616r 1               .endproc
001616r 1               
001616r 1               .proc reset
001616r 1  78               SEI
001617r 1  A2 00            LDX #0
001619r 1  8E 00 20         STX $2000   ; обнуляем память
00161Cr 1  8E 01 20         STX $2001   ; выключаем рендер
00161Fr 1  8E 10 40         STX $4010 ; отключаем DMC
001622r 1  CA               DEX     ; X = $FF
001623r 1  9A               TXS     ; Стэк равен = $FF
001624r 1  2C 02 20         : BIT $2002
001627r 1  10 FB            BPL :-
001629r 1               
001629r 1  20 rr rr         JSR initMMC3
00162Cr 1  20 rr rr         JSR loadBanks
00162Fr 1               
00162Fr 1  20 rr rr         JSR setHeroVar
