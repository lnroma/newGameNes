0010ADr 2               
0010ADr 2               .proc stopScrollingProcedure
0010ADr 2  A5 rr            LDA stopScroll
0010AFr 2  F0 11            BEQ return
0010B1r 2               
0010B1r 2  AD rr rr         LDA yScrollPosition
0010B4r 2  C9 D9            CMP #$D9
0010B6r 2  F0 02            BEQ stopScrolling
0010B8r 2  D0 05            BNE increment
0010BAr 2                   stopScrolling:
0010BAr 2  A9 00                LDA #$00
0010BCr 2  85 rr                STA stopScroll
0010BEr 2  60                   RTS
0010BFr 2                   increment:
0010BFr 2  EE rr rr             INC yScrollPosition
0010C2r 2                   return:
0010C2r 2  60                   RTS
0010C3r 2               .endproc
0010C3r 2               
0010C3r 2               .proc scrollingScreenY
0010C3r 2  A9 00            LDA #$00
0010C5r 2  8D 05 20         STA $2005
0010C8r 2  AD rr rr         LDA yScrollPosition
0010CBr 2  8D 05 20         STA $2005
0010CEr 2  60               RTS
0010CFr 2               .endproc
