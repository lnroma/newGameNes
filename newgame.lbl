000E58r 2               .proc loadBackground
000E58r 2                   LoadBackground:
000E58r 2  AD 02 20           LDA $2002             ; read PPU status to reset the high/low latch
000E5Br 2  A5 rr              LDA highBackground
000E5Dr 2  8D 06 20           STA $2006             ; write the high byte of $2000 address
000E60r 2  A5 rr              LDA lowBackground
000E62r 2  8D 06 20           STA $2006             ; write the low byte of $2000 address
000E65r 2               
000E65r 2  A2 00              LDX #$00            ; start at pointer + 0
000E67r 2  A0 00              LDY #$00
000E69r 2                   OutsideLoop:
000E69r 2               
000E69r 2                   InsideLoop:
000E69r 2  B1 rr              LDA (mapLoByte), y  ; copy one background byte from address in pointer plus Y
000E6Br 2  8D 07 20           STA $2007           ; this runs 256 * 4 times
000E6Er 2               
000E6Er 2  C8                 INY                 ; inside loop counter
000E6Fr 2  C0 00              CPY #$00
000E71r 2  D0 F6              BNE InsideLoop      ; run the inside loop 256 times before continuing down
000E73r 2               
000E73r 2  EE rr rr           INC mapHiByte       ; low byte went 0 to 256, so high byte needs to be changed now
000E76r 2               
000E76r 2  E8                 INX
000E77r 2  E0 04              CPX #$04
000E79r 2  D0 EE              BNE OutsideLoop     ; run the outside loop 256 times before continuing down
000E7Br 2               
000E7Br 2  60                 RTS
