000E5Cr 2  29 FC            AND #%11111100
000E5Er 2  0A               ASL A
000E5Fr 2  8D rr rr         STA sourceLow
000E62r 2  AD rr rr         LDA columnNumber
000E65r 2  4A               LSR A
000E66r 2  4A               LSR A
000E67r 2  4A               LSR A
000E68r 2  4A               LSR A
000E69r 2  4A               LSR A
000E6Ar 2  4A               LSR A
000E6Br 2  4A               LSR A
000E6Cr 2  8D rr rr         STA sourceHig
000E6Fr 2               
000E6Fr 2  AD rr rr         LDA sourceLow
000E72r 2  18               CLC
000E73r 2  6D rr rr         ADC lAB
000E76r 2  8D rr rr         STA sourceLow
000E79r 2  AD rr rr         LDA sourceHig
