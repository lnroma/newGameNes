000D8Cr 2               
000D8Cr 2               
000D8Cr 2  78           	sei
000D8Dr 2  A2 00        	ldx #0
000D8Fr 2  8E 00 20     	stx $2000		; обнуляем память
000D92r 2  8E 01 20     	stx $2001		; выключаем рендер
000D95r 2  8E 10 40     	stx $4010	; отключаем DMC
000D98r 2  CA           	dex 				; X = $FF
000D99r 2  9A           	txs					; Стэк равен = $FF
000D9Ar 2  2C 02 20     :	bit $2002
000D9Dr 2  10 FB        	bpl :-
000D9Fr 2               
000D9Fr 2  60           	RTS
000DA0r 2               .endproc
