000CC2r 2               .proc loadPaleteStageTwo
000CC2r 2                 LoadPalettes:
000CC2r 2  AD 02 20         LDA $2002
000CC5r 2  A9 3F            LDA #$3F
000CC7r 2  8D 06 20         STA $2006             ; говорим ppu что нам необходим адрес 3F00 здесь храниться палитра
000CCAr 2  A9 00            LDA #$00
000CCCr 2  8D 06 20         STA $2006             ; Сначала старший байт записываем 3F потом младший 00 при записи этот адрес будет автоматически увеличиваться
000CCFr 2               
000CCFr 2  A2 00            LDX #$00              ; X = 0
000CD1r 2                 LoadPalettesLoop:
000CD1r 2  BD rr rr         LDA palette_data_stage_2, x
000CD4r 2  8D 07 20         STA $2007             ; записываем в ppu по факту в адрес 3F00
000CD7r 2  E8               INX                   ; X = X + 1
000CD8r 2  E0 20            CPX #$20
000CDAr 2  D0 F5            BNE LoadPalettesLoop
000CDCr 2               
000CDCr 2  60               RTS
000CDDr 2               .endproc
