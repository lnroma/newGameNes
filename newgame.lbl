000EAEr 2               
000EAEr 2  4A               LSR A ; смещение право
000EAFr 2  4A               LSR A
000EB0r 2  4A               LSR A ; / 8
000EB1r 2  8D rr rr         STA colLow
000EB4r 2  8D rr rr         STA columnNumber
000EB7r 2               
000EB7r 2  AD rr rr         LDA nameTable
000EBAr 2  0A               ASL A
000EBBr 2  0A               ASL A ; * 4
000EBCr 2  18               CLC
000EBDr 2  69 24            ADC #$24
000EBFr 2  8D rr rr         STA colHig
000EC2r 2               
000EC2r 2  AD rr rr         LDA columnNumber
000EC5r 2  0A               ASL A
000EC6r 2  0A               ASL A
000EC7r 2  0A               ASL A
000EC8r 2  0A               ASL A
000EC9r 2  0A               ASL A
000ECAr 2  8D rr rr         STA sourceLow
000ECDr 2  AD rr rr         LDA columnNumber
000ED0r 2  4A               LSR A
000ED1r 2  4A               LSR A
000ED2r 2  4A               LSR A
