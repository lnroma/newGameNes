000DA6r 2               .segment "ZEROPAGE"
000025r 2  xx               tmpSBC: .res 1
000026r 2  xx               highBackground: .res 1
000027r 2  xx               lowBackground: .res 1
000028r 2  xx               loadedFlag: .res 1
000029r 2  xx               indYBack: .res 1
00002Ar 2  xx               indXBack: .res 1
00002Br 2  xx               oldScroll: .res 1
00002Cr 2               
00002Cr 2               .segment "CODE"
000DA6r 2               
000DA6r 2               .proc firstProcBackground
000DA6r 2  A9 20           LDA #$20
000DA8r 2  85 rr           STA highBackground
000DAAr 2  A9 00           LDA #$00
000DACr 2  85 rr           STA lowBackground
000DAEr 2  85 rr           STA indXBack
000DB0r 2  85 rr           STA indYBack
000DB2r 2  A9 01           LDA #$01
000DB4r 2  85 rr           STA loadedFlag
000DB6r 2               
000DB6r 2  60              RTS
000DB7r 2               .endproc
000DB7r 2               
000DB7r 2               .proc loadBackground
000DB7r 2                   LoadBackground:
000DB7r 2  AD 02 20           LDA $2002             ; read PPU status to reset the high/low latch
000DBAr 2  A5 rr              LDA highBackground
000DBCr 2  8D 06 20           STA $2006             ; write the high byte of $2000 address
000DBFr 2  A5 rr              LDA lowBackground
000DC1r 2  8D 06 20           STA $2006             ; write the low byte of $2000 address
000DC4r 2               
000DC4r 2  A2 00              LDX #$00            ; start at pointer + 0
000DC6r 2  A0 00              LDY #$00
000DC8r 2                   OutsideLoop:
000DC8r 2               
000DC8r 2                   InsideLoop:
000DC8r 2  B1 rr              LDA (mapLoByte), y  ; copy one background byte from address in pointer plus Y
000DCAr 2  8D 07 20           STA $2007           ; this runs 256 * 4 times
000DCDr 2               
000DCDr 2  C8                 INY                 ; inside loop counter
000DCEr 2  C0 00              CPY #$00
000DD0r 2  D0 F6              BNE InsideLoop      ; run the inside loop 256 times before continuing down
000DD2r 2               
000DD2r 2  EE rr rr           INC mapHiByte       ; low byte went 0 to 256, so high byte needs to be changed now
000DD5r 2               
000DD5r 2  E8                 INX
000DD6r 2  E0 04              CPX #$04
000DD8r 2  D0 EE              BNE OutsideLoop     ; run the outside loop 256 times before continuing down
000DDAr 2               
000DDAr 2  60                 RTS
000DDBr 2               .endproc
000DDBr 2               
000DDBr 2               .proc loadBackgroundAnimated
000DDBr 2  A5 rr            LDA loadedFlag
000DDDr 2  F0 02            BEQ returnLoad
000DDFr 2  D0 01            BNE continueLoad
000DE1r 2                   returnLoad:
000DE1r 2  60                   RTS
000DE2r 2                   continueLoad:
000DE2r 2  AD rr rr             LDA nmiCounter
000DE5r 2  D0 02                BNE returnByCounter
000DE7r 2  F0 01                BEQ continueLoadAfterCounter
000DE9r 2                   returnByCounter:
000DE9r 2  60                   RTS
000DEAr 2                   continueLoadAfterCounter:
000DEAr 2  AD 02 20             LDA $2002             ; read PPU status to reset the high/low latch
000DEDr 2  A5 rr                LDA highBackground
000DEFr 2  8D 06 20             STA $2006             ; write the high byte of $2000 address
000DF2r 2  A5 rr                LDA lowBackground
000DF4r 2  8D 06 20             STA $2006
000DF7r 2               
000DF7r 2  A4 rr                LDY indYBack
000DF9r 2  B1 rr                LDA (mapLoByte), y
000DFBr 2  8D 07 20             STA $2007
000DFEr 2  E6 rr                INC indYBack
000E00r 2  E6 rr                INC lowBackground
000E02r 2  C0 FF                CPY #$FF
000E04r 2  F0 02                BEQ incX
000E06r 2  D0 05                BNE return
000E08r 2                   incX:
000E08r 2  EE rr rr             INC mapHiByte
000E0Br 2  E6 rr                INC highBackground
000E0Dr 2                   return:
000E0Dr 2  60                   RTS
000E0Er 2               .endproc
000E0Er 2               
000E0Er 2               .proc delay
000E0Er 2  48               PHA
000E0Fr 2  8A               TXA
000E10r 2  48               PHA
000E11r 2               
000E11r 2  A2 FF            LDX #$FF
000E13r 2                   decX:
000E13r 2  CA               DEX
000E14r 2  D0 FD            BNE decX
000E16r 2               
000E16r 2  68               PLA
000E17r 2  AA               TAX
000E18r 2  68               PLA
000E19r 2               
000E19r 2  60               RTS
000E1Ar 2               .endproc
