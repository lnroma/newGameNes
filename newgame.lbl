0015A9r 1               .proc loadBanks
0015A9r 1  A2 08                LDX #$08            ; Start of Page to load Add 8 Hex per CHR .. CHR 3 = $10 or 16
0015ABr 1  A9 80                LDA #$80            ; Starting Address for $8000 0,1,2,3,4,5,6
0015ADr 1  A0 00                LDY #$00            ; Loop Counter
0015AFr 1                       LoadPPU2k:          ; load two sets 2x2k to make first 4k (BACKGROUND)
0015AFr 1  8D 00 80                 STA $8000       ; Bank Selection with Inversion
0015B2r 1  8E 01 80                 STX $8001       ; Selection of Bank
0015B5r 1  C8                       INY
0015B6r 1  E8                       INX             ; Increase X x 2 as 2k
0015B7r 1  E8                       INX
0015B8r 1  18                       CLC
0015B9r 1  69 01                    ADC #$01
0015BBr 1  C0 02                    CPY #$02        ; For loop
0015BDr 1  D0 F0                    BNE LoadPPU2k
0015BFr 1                       LoadPPU1k:              ; load 4 * 1k sets to make FORGROUND 4k
0015BFr 1  8D 00 80                 STA $8000           ; Bank Selection with Inversion
0015C2r 1  8E 01 80                 STX $8001           ; Selection of Bank
0015C5r 1  C8                       INY
0015C6r 1  E8                       INX                 ; Increase X * x as 1k
0015C7r 1  18                       CLC
0015C8r 1  69 01                    ADC #$01
0015CAr 1  C0 06                    CPY #$06        ; For loop
0015CCr 1  D0 F1                    BNE LoadPPU1k
0015CEr 1  60               RTS
0015CFr 1               .endproc
0015CFr 1               
0015CFr 1               .proc initMMC3
0015CFr 1  A2 00            LDX #$00
0015D1r 1  A9 00            LDA #$00
0015D3r 1  8D 00 E0         STA $E000       ; IRQ disable
0015D6r 1  8D 00 A0         STA $A000       ; mirroring 0 Vertical; 1 Horizontal
0015D9r 1                   :
0015D9r 1  8E 00 80         STX $8000       ; select register
0015DCr 1  BD rr rr         LDA mmc3Register, X
0015DFr 1  8D 01 80         STA $8001       ; initialize register
0015E2r 1  E8               INX
0015E3r 1  E0 08            CPX #8          ; Compare 8 to X
0015E5r 1  90 F2            BCC :-          ; Branch not Equal
0015E7r 1               
0015E7r 1                   ;PRG ROM Selections
0015E7r 1               
0015E7r 1  A0 02                LDY #02            ; Starting Banks Change This from 0 2 4 6 ETC to change Starting Color Startup $00
0015E9r 1  A9 06                LDA #6              ; $8000 Selection Bank = 6 (NOTE: Not HEX)
0015EBr 1  8D 00 80             STA $8000
0015EEr 1  8C 01 80             STY $8001           ; Select Bank LOW
0015F1r 1  A9 07                LDA #7              ; $A000 Selection Bank = 6 (NOTE: Not HEX)
0015F3r 1  8D 00 80             STA $8000
0015F6r 1  C8                   INY
0015F7r 1  8C 01 80             STY $8001           ; Select Bank HIGH
0015FAr 1               
0015FAr 1  60                   rts
0015FBr 1               .endproc
0015FBr 1               
