001601r 1  8E 01 20         STX $2001   ; выключаем рендер
001604r 1  8E 10 40         STX $4010 ; отключаем DMC
001607r 1  CA               DEX     ; X = $FF
001608r 1  9A               TXS     ; Стэк равен = $FF
001609r 1  2C 02 20         : BIT $2002
00160Cr 1  10 FB            BPL :-
00160Er 1               
00160Er 1  20 rr rr         JSR initMMC3
001611r 1  20 rr rr         JSR loadBanks
001614r 1               
001614r 1  20 rr rr         JSR setHeroVar
001617r 1  20 rr rr         JSR setStageVar
