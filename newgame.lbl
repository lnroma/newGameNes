000D8Br 2               .segment "ZEROPAGE"
000024r 2  xx               tmpSBC: .res 1
000025r 2  xx               highBackground: .res 1
000026r 2  xx               lowBackground: .res 1
000027r 2  xx               loadedFlag: .res 1
000028r 2  xx               indYBack: .res 1
000029r 2  xx               indXBack: .res 1
00002Ar 2  xx               oldScroll: .res 1
00002Br 2               
00002Br 2               .segment "CODE"
000D8Br 2               
000D8Br 2               .proc firstProcBackground
000D8Br 2  A9 20           LDA #$20
000D8Dr 2  85 rr           STA highBackground
000D8Fr 2  A9 00           LDA #$00
000D91r 2  85 rr           STA lowBackground
000D93r 2  85 rr           STA indXBack
000D95r 2  85 rr           STA indYBack
000D97r 2  A9 01           LDA #$01
000D99r 2  85 rr           STA loadedFlag
000D9Br 2               
000D9Br 2  60              RTS
000D9Cr 2               .endproc
000D9Cr 2               
000D9Cr 2               .proc loadBackground
000D9Cr 2                   LoadBackground:
000D9Cr 2  AD 02 20           LDA $2002             ; read PPU status to reset the high/low latch
000D9Fr 2  A5 rr              LDA highBackground
000DA1r 2  8D 06 20           STA $2006             ; write the high byte of $2000 address
000DA4r 2  A5 rr              LDA lowBackground
000DA6r 2  8D 06 20           STA $2006             ; write the low byte of $2000 address
000DA9r 2               
000DA9r 2  A2 00              LDX #$00            ; start at pointer + 0
000DABr 2  A0 00              LDY #$00
000DADr 2                   OutsideLoop:
000DADr 2               
000DADr 2                   InsideLoop:
000DADr 2  B1 rr              LDA (mapLoByte), y  ; copy one background byte from address in pointer plus Y
000DAFr 2  8D 07 20           STA $2007           ; this runs 256 * 4 times
000DB2r 2               
000DB2r 2  C8                 INY                 ; inside loop counter
000DB3r 2  C0 00              CPY #$00
000DB5r 2  D0 F6              BNE InsideLoop      ; run the inside loop 256 times before continuing down
000DB7r 2               
000DB7r 2  EE rr rr           INC mapHiByte       ; low byte went 0 to 256, so high byte needs to be changed now
000DBAr 2               
000DBAr 2  E8                 INX
000DBBr 2  E0 04              CPX #$04
000DBDr 2  D0 EE              BNE OutsideLoop     ; run the outside loop 256 times before continuing down
000DBFr 2               
000DBFr 2  60                 RTS
000DC0r 2               .endproc
000DC0r 2               
000DC0r 2               .proc loadBackgroundAnimated
000DC0r 2  A5 rr            LDA loadedFlag
000DC2r 2  F0 02            BEQ returnLoad
000DC4r 2  D0 01            BNE continueLoad
000DC6r 2                   returnLoad:
000DC6r 2  60                   RTS
000DC7r 2                   continueLoad:
000DC7r 2  AD rr rr             LDA nmiCounter
000DCAr 2  D0 02                BNE returnByCounter
000DCCr 2  F0 01                BEQ continueLoadAfterCounter
000DCEr 2                   returnByCounter:
000DCEr 2  60                   RTS
000DCFr 2                   continueLoadAfterCounter:
000DCFr 2  AD 02 20             LDA $2002             ; read PPU status to reset the high/low latch
000DD2r 2  A5 rr                LDA highBackground
000DD4r 2  8D 06 20             STA $2006             ; write the high byte of $2000 address
000DD7r 2  A5 rr                LDA lowBackground
000DD9r 2  8D 06 20             STA $2006
000DDCr 2               
000DDCr 2  A4 rr                LDY indYBack
000DDEr 2  B1 rr                LDA (mapLoByte), y
000DE0r 2  8D 07 20             STA $2007
000DE3r 2  E6 rr                INC indYBack
000DE5r 2  E6 rr                INC lowBackground
000DE7r 2  C0 FF                CPY #$FF
000DE9r 2  F0 02                BEQ incX
000DEBr 2  D0 05                BNE return
000DEDr 2                   incX:
000DEDr 2  EE rr rr             INC mapHiByte
000DF0r 2  E6 rr                INC highBackground
000DF2r 2                   return:
000DF2r 2  60                   RTS
000DF3r 2               .endproc
000DF3r 2               
000DF3r 2               .proc delay
000DF3r 2  48               PHA
000DF4r 2  8A               TXA
000DF5r 2  48               PHA
000DF6r 2               
