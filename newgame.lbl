000D51r 2  09 0A 0C 0D    		.byt $09,$0A,$0C,$0D,  $21,$0C,$08,$28,  $21,$1C,$29,$07,  $31,$3F,$3c,$02   ;;background
000D55r 2  21 0C 08 28  
000D59r 2  21 1C 29 07  
000D61r 2  32 10 1A 0F    		.byt $32,$10,$1A,$0F,  $32,$36,$17,$0F,  $32,$30,$21,$0F,  $32,$27,$17,$0F   ;;sprite palette
000D65r 2  32 36 17 0F  
000D69r 2  32 30 21 0F  
000D71r 2               
000D71r 2               .segment "CODE"
000D71r 2               
000D71r 2               .proc loadPalete
000D71r 2                 LoadPalettes:
000D71r 2  AD 02 20         LDA $2002
000D74r 2  A9 3F            LDA #$3F
000D76r 2  8D 06 20         STA $2006             ; говорим ppu что нам необходим адрес 3F00 здесь храниться палитра
000D79r 2  A9 00            LDA #$00
000D7Br 2  8D 06 20         STA $2006             ; Сначала старший байт записываем 3F потом младший 00 при записи этот адрес будет автоматически увеличиваться
000D7Er 2               
000D7Er 2  A2 00            LDX #$00              ; X = 0
000D80r 2                 LoadPalettesLoop:
000D80r 2  BD rr rr         LDA palette_data, x
000D83r 2  8D 07 20         STA $2007             ; записываем в ppu по факту в адрес 3F00
000D86r 2  E8               INX                   ; X = X + 1
000D87r 2  E0 20            CPX #$20
000D89r 2  D0 F5            BNE LoadPalettesLoop
000D8Br 2  60               RTS
000D8Cr 2               .endproc
