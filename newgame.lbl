000D56r 2                 LoadPalettes:
000D56r 2  AD 02 20         LDA $2002
000D59r 2  A9 3F            LDA #$3F
000D5Br 2  8D 06 20         STA $2006             ; говорим ppu что нам необходим адрес 3F00 здесь храниться палитра
000D5Er 2  A9 00            LDA #$00
000D60r 2  8D 06 20         STA $2006             ; Сначала старший байт записываем 3F потом младший 00 при записи этот адрес будет автоматически увеличиваться
000D63r 2               
000D63r 2  A2 00            LDX #$00              ; X = 0
000D65r 2                 LoadPalettesLoop:
000D65r 2  BD rr rr         LDA palette_data, x
000D68r 2  8D 07 20         STA $2007             ; записываем в ppu по факту в адрес 3F00
000D6Br 2  E8               INX                   ; X = X + 1
000D6Cr 2  E0 20            CPX #$20
000D6Er 2  D0 F5            BNE LoadPalettesLoop
000D70r 2  60               RTS
000D71r 2               .endproc
